{
  "name": "cardmarket-mtg-trend-checker",
  "version": "1.2.1",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "description": "Firefox extension comparing Cardmarket MTG prices with the trend of the cheapest English printing.",
  "scripts": {
    "start": "web-ext run --source-dir extension --start-url https://www.cardmarket.com/en/Magic/ShoppingCart",
    "test": "node --test \"test/*.test.js\"",
    "typecheck": "tsc -p jsconfig.json",
    "lint": "web-ext lint --source-dir extension --self-hosted",
    "check": "npm run typecheck && npm test && npm run lint",
    "build": "web-ext build --source-dir extension --artifacts-dir dist --overwrite-dest"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^120.0.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.6.0",
    "web-ext": "^10.8.0"
  }
}
